{
  "name": "lft-archive-manager",
  "version": "1.0.0",
  "description": "Lift – File Compression & Archive Manager",
  "main": "main.js",
  "author": "True.Velocity",
  "license": "Proprietary",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.lift.lift",
    "productName": "Lift",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "package.json"
    ],
"win": {
  "target": [
    {
      "target": "portable",
      "arch": ["x64"]
    }
  ]
},
      "icon": "public/LFT-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}